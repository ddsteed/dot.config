#!/bin/bash
# ==============================================================
# SketchyBar - Geek Glass (semi-transparent + blur)
# Pure glass strip: item backgrounds OFF (except workspace underline)
# ==============================================================
# Right side order (requested):
#   weather • cpu/mem • time • input
# Update:
#   cpu/mem + time update every 5 seconds
# ==============================================================

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# Load theme (optional)
THEME_FILE="$PLUGIN_DIR/theme.sh"
if [[ -f "$THEME_FILE" ]]; then
  source "$THEME_FILE"
fi

# Fallbacks
FONT="${FONT:-Hack Nerd Font}"
FG="${FG:-0xFFEDEDED}"
MUTED="${MUTED:-0xFF8A8F98}"
ACCENT="${ACCENT:-0xFF66D9EF}"
BAR_BG="${BAR_BG:-0x33121720}"
SEP_COLOR="${SEP_COLOR:-0xFF3B4048}"
SPACE_COUNT="${SPACE_COUNT:-10}"

# --------------------------------------------------------------
# Bar: glass
# --------------------------------------------------------------
sketchybar --bar \
  height=32 \
  position=top \
  sticky=on \
  color=$BAR_BG \
  blur_radius=10 \
  corner_radius=8 \
  y_offset=0 \
  margin=0 \
  padding_left=8 \
  padding_right=8 \
  shadow=on

# --------------------------------------------------------------
# Defaults: no item background
# --------------------------------------------------------------
sketchybar --default \
  icon.font="$FONT:Bold:15.0" \
  label.font="$FONT:Semibold:14.0" \
  icon.color=$FG \
  label.color=$FG \
  padding_left=8 \
  padding_right=8 \
  background.drawing=off

# --------------------------------------------------------------
# Monitor hotplug watcher
# --------------------------------------------------------------
sketchybar --add item monitor_watcher left \
  --set monitor_watcher drawing=off \
  --subscribe monitor_watcher display_change \
  --set monitor_watcher script="$PLUGIN_DIR/auto_gaps.sh"

# --------------------------------------------------------------
# Left: Logo
# --------------------------------------------------------------
sketchybar --add item logo left \
  --set logo \
  icon.font="JetBrainsMono Nerd Font:Regular:13.0" \
  icon="" \
  icon.color=$ACCENT \
  icon.padding_left=6 \
  icon.padding_right=10 \
  label.drawing=off \
  click_script="open -a 'Finder'"

# --------------------------------------------------------------
# Events
# --------------------------------------------------------------
sketchybar --add event aerospace_workspace_change
sketchybar --add event input_change "AppleSelectedInputSourcesChangedNotification"

# --------------------------------------------------------------
# Left: Aerospace Workspaces (accent underline on focused)
# --------------------------------------------------------------
for sid in $(seq 1 "$SPACE_COUNT"); do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change space_change space_windows_change front_app_switched \
    --set space.$sid \
    icon="$sid" \
    icon.padding_left=10 \
    icon.padding_right=8 \
    label.padding_right=10 \
    label.font="$FONT:Regular:13" \
    script="$PLUGIN_DIR/aerospace.sh $sid" \
    click_script="aerospace workspace $sid"
done

# --------------------------------------------------------------
# Center: Front App (icon + name)
# --------------------------------------------------------------
sketchybar --add item front_app center \
  --set front_app \
  icon.drawing=on \
  icon.font="$FONT:Regular:13.0" \
  icon.padding_right=6 \
  label.font="$FONT:Bold:14.0" \
  label.color=$FG \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# Weather
sketchybar --add item weather right \
  --set weather \
  update_freq=1200 \
  script="$PLUGIN_DIR/weather.sh" \
  icon="" \
  icon.drawing=off \
  icon.color=$MUTED \
  label="..." \
  label.font="SF Mono:Regular:13" \
  label.y_offset=-1 \
  label.padding_left=6 \
  --subscribe weather system_woke

# Separator (Weather • Sys)
sketchybar --add item sep_weather_sys right \
  --set sep_weather_sys \
  icon="•" \
  icon.font="$FONT:Regular:13.0" \
  icon.color=$SEP_COLOR \
  label.drawing=off \
  icon.padding_left=2 \
  icon.padding_right=2

# MEM slider (updated by same script)
# Small gap between CPU and MEM blocks
sketchybar --add item sep_cpu_mem_gap right \
           --set sep_cpu_mem_gap \
           drawing=on \
           width=4 \
           icon.drawing=off \
           label.drawing=off \
           background.drawing=off

sketchybar --add slider mem.slider right \
           --set mem.slider \
           drawing=on \
           icon.drawing=off \
           label.drawing=off \
           background.drawing=off \
           slider.width=32 \
           slider.percentage=60 \
           slider.highlight_color=0xFF00FF6A \
           slider.knob.drawing=off \
           slider.background.drawing=on \
           slider.background.color=0x55222222 \
           slider.background.border_width=1 \
           slider.background.border_color=0x55FFFFFF \
           slider.background.corner_radius=6 \
           slider.background.height=10 \
           y_offset=0 \
           padding_left=2 \
           padding_right=0 \
           --subscribe mem.slider system_woke

# MEM percentage label
sketchybar --add item mem.pct right \
           --set mem.pct \
           icon.drawing=off \
           label="--%" \
           label.font="SF Mono:Regular:11" \
           label.color=$FG \
           label.width=36 \
           label.align=right \
           label.padding_left=2 \
           label.padding_right=0 \
           background.drawing=off

# CPU slider (v2.23-compatible: use slider.background.* for track styling)
sketchybar --add slider cpu.slider right \
           --set cpu.slider \
           drawing=on \
           update_freq=5 \
           script="$PLUGIN_DIR/sys_rainbow.sh" \
           icon.drawing=off \
           label.drawing=off \
           background.drawing=off \
           slider.width=32 \
           slider.percentage=35 \
           slider.highlight_color=0xFF00FF6A \
           slider.knob.drawing=off \
           slider.background.drawing=on \
           slider.background.color=0x55222222 \
           slider.background.border_width=1 \
           slider.background.border_color=0x55FFFFFF \
           slider.background.corner_radius=6 \
           slider.background.height=10 \
           y_offset=0 \
           padding_left=0 \
           padding_right=0 \
           --subscribe cpu.slider system_woke

# CPU percentage label
sketchybar --add item cpu.pct right \
           --set cpu.pct \
           icon.drawing=off \
           label="--%" \
           label.font="SF Mono:Regular:11" \
           label.color=$FG \
           label.width=36 \
           label.align=right \
           label.padding_left=2 \
           label.padding_right=0 \
           background.drawing=off

# Separator (Sys • Clock)
sketchybar --add item sep_sys_clock right \
           --set sep_sys_clock \
           icon="•" \
           icon.font="$FONT:Regular:13.0" \
           icon.color=$SEP_COLOR \
           label.drawing=off \
           icon.padding_left=2 \
           icon.padding_right=2

# Clock (time) - requested: right of cpu/mem, left of input
sketchybar --add item clock right \
           --set clock \
           update_freq=10 \
           script="$PLUGIN_DIR/clock.sh" \
           icon.drawing=off \
           label="--:--" \
           #label.font="$FONT:Regular:13.0" \
           label.font="SF Mono:Regular:13" \
           label.color=$FG \
           label.padding_left=0 \
           label.padding_right=0 \
           --subscribe clock system_woke


# Date (right of clock): "Mar 04"
sketchybar --add item date right \
           --set date \
           icon.drawing=off \
           label="--- --" \
           label.font="SF Mono:Regular:13" \
           label.color=$FG \
           label.padding_left=2 \
           label.padding_right=0 \
           background.drawing=off

# Separator (Clock • Battery)
sketchybar --add item sep_clock_batt right \
           --set sep_clock_batt \
           icon="•" \
           icon.font="$FONT:Regular:13.0" \
           icon.color=$SEP_COLOR \
           label.drawing=off \
           icon.padding_left=2 \
           icon.padding_right=2

# Battery state text
sketchybar --add item battery.state right \
           --set battery.state \
           update_freq=30 \
           script="$PLUGIN_DIR/battery.sh" \
           icon.drawing=off \
           label="..." \
           #label.font="$FONT:Regular:11.0" \
           label.font="SF Mono:Regular:11" \
           label.color=$FG \
           label.padding_left=0 \
           label.padding_right=2 \
           background.drawing=off \
           --subscribe battery.state system_woke

# Battery slider (progress bar)
sketchybar --add slider battery.slider right \
           --set battery.slider \
           drawing=on \
           icon.drawing=off \
           label.drawing=off \
           background.drawing=off \
           slider.width=32 \
           slider.percentage=50 \
           slider.highlight_color=0xFF00FF6A \
           slider.knob.drawing=off \
           slider.background.drawing=on \
           slider.background.color=0x55222222 \
           slider.background.border_width=1 \
           slider.background.border_color=0x55FFFFFF \
           slider.background.corner_radius=6 \
           slider.background.height=10 \
           y_offset=0 \
           padding_left=0 \
           padding_right=0 \
           --subscribe battery.slider system_woke

# Battery percentage label
sketchybar --add item battery.pct right \
           --set battery.pct \
           icon.drawing=off \
           label="--%" \
           label.font="$FONT:Regular:11.5" \
           #label.font="SF Mono:Regular:10" \
           label.color=$FG \
           label.padding_left=2 \
           label.padding_right=0 \
           background.drawing=off

# Separator (Battery • Input)
sketchybar --add item sep_batt_input right \
           --set sep_batt_input \
           icon="•" \
           icon.font="$FONT:Regular:13.0" \
           icon.color=$SEP_COLOR \
           label.drawing=off \
           icon.padding_left=2 \
           icon.padding_right=2

# Input method
sketchybar --add item input right \
  --set input \
  script="$PLUGIN_DIR/input.sh" \
  icon="⌨︎" \
  icon.color=$FG \
  label="..." \
  label.color=$FG \
  label.font="SF Mono:Bold:14" \
  --subscribe input input_change

# -------------------------------------------------------------------------
# Force right-side order: weather • mem • cpu • clock date • battery •input
# -------------------------------------------------------------------------
sketchybar --reorder \
           weather sep_weather_sys \
           mem.slider mem.pct sep_cpu_mem_gap cpu.slider cpu.pct sep_sys_clock \
           date clock sep_clock_batt \
           battery.state battery.slider battery.pct sep_batt_input \
           input

sketchybar --update
